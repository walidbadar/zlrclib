 /delete-node/ &storage_partition;

 &flash0 {
     partitions {
         compatible = "fixed-partitions";
         #address-cells = <1>;
         #size-cells = <1>;
 
         storage_partition: partition@f0000 {
             label = "storage";
             reg = <0x000f0000 DT_SIZE_K(1024)>;
         };
     };
 };

 &sdl_dc {
	compatible = "zephyr,sdl-dc";
	width = <320>;
    height = <240>;
};
