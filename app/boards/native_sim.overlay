#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lvgl/lvgl.h>

/delete-node/ &storage_partition;

/ {
	keys: keys {
		compatible = "gpio-keys";
		button_up: button_up {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_UP>;
		};

		button_down: button_down {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_DOWN>;
		};

		button_enter: button_enter {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};

		button_back: button_back {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_BACKSPACE>;
		};
	};

	lvgl_keypad_input {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&keys>;
		input-codes = <INPUT_KEY_UP INPUT_KEY_DOWN INPUT_KEY_ENTER INPUT_KEY_BACKSPACE>;
		lvgl-codes = <LV_KEY_UP LV_KEY_DOWN LV_KEY_ENTER LV_KEY_BACKSPACE>;
	};
};

&gpio0 {
	ngpios = <5>;

	sdl_gpio {
		status = "okay";
		compatible = "zephyr,gpio-emul-sdl";
		/* Skip pin 0 with the unknown code 0 */
		scancodes = <0 82 81 40 42>;
	};
};

&sdl_dc {
	compatible = "zephyr,sdl-dc";
	width = <128>;
    height = <64>;
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        storage_partition: partition@f0000 {
            label = "storage";
            reg = <0x000f0000 DT_SIZE_K(1024)>;
        };
    };
};
