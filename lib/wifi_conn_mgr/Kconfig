menuconfig WIFI_CONNECTION_MANAGER
    bool "Enable WiFi Connection Manager"
    depends on WIFI
    depends on NET_L2_WIFI_MGMT
    select LED
    help
      Enable the WiFi connection manager subsystem, which handles WiFi
      connection and disconnection logic, retry policies, and optional
      access-point and DHCP server support.

if WIFI_CONNECTION_MANAGER

menu "WiFi Station Configuration"

config WIFI_STATIC_SSID
    string "WiFi SSID"
    default "YourSSID"
    help
      The SSID of the WiFi network to connect to in station (client) mode.

config WIFI_STATIC_PSK
    string "WiFi Password"
    default "YourPassword"
    help
      The pre-shared key (password) for the WiFi network.

config WIFI_CONN_RETRY_DELAY
    int "WiFi Connection Retry Delay (seconds)"
    default 5
    help
      Time in seconds to wait before retrying a failed connection attempt.

endmenu  # WiFi Station Configuration

menu "WiFi Access Point Configuration"

config WIFI_AP_STATIC_SSID
    string "Access Point SSID"
    default "Zephyr-AP"
    help
      SSID that will be broadcast when running in AP mode.

config WIFI_AP_STATIC_PSK
    string "Access Point Password"
    default ""
    help
      WPA2 password for the access point. Leave empty for open network.

config WIFI_AP_STATIC_IP_ADDR
    string "Static IP Address"
    default "192.168.4.1"
    help
      IP address assigned to the device in AP mode.

config WIFI_AP_STATIC_NETMASK
    string "Static Netmask"
    default "255.255.255.0"
    help
      Network mask used in AP mode.

endmenu  # WiFi Access Point Configuration

menu "DHCP Server Configuration"

config NET_DHCPV4_SERVER
    bool "Enable DHCP Server"
    default y if WIFI_USAGE_MODE_STA_AP
    help
      Enable a DHCP server when in AP mode. Devices connecting to the
      AP will be assigned IP addresses automatically.

endmenu  # DHCP Server Configuration

module = WIFI_CONNECTION_MANAGER
module-str = wifi_conn_mgr
source "subsys/logging/Kconfig.template.log_config"

endif  # WIFI_CONNECTION_MANAGER

